---
// One prerendered page per school. The client script opens the sheet from
// the path exactly as it opens it from a marker; Task 3 prerenders the sheet
// itself so the page carries the school before any script runs.
import Base from '../../layouts/Base.astro';
import { loadDataset } from '../../data';
import { slug } from '../../helpers';
import { schoolHead } from '../../prerender';
import type { School } from '../../types';

export function getStaticPaths() {
  return loadDataset().schools.map(s => ({ params: { fylke: slug(s.fylke), skole: slug(s.name) }, props: { school: s } }));
}
const { school } = Astro.props as { school: School };
---
<Base {...schoolHead(school)} />
