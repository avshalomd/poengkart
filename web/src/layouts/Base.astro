---
// The <head> of every page, the prefs script that runs before first paint,
// the shell, and the one client script. The two stylesheets are imported here
// in the order the old <head> loaded them: the map engine's, then the app's,
// whose rules must win the cascade.
import 'maplibre-gl/dist/maplibre-gl.css';
import '../styles/app.css';
import shellSrc from '../shell.html?raw';
// the version the build vendored into web/public/maplibre/<version>/, the same
// one astro.config.mjs rewrites the app's `maplibre-gl` import to. It comes
// from that config's `define`, not from an import of tools/vendor-maplibre.mjs:
// bundled into the prerender entry, that module would look for node_modules
// beside itself, under web/dist/.prerender/, and find nothing.
const MAPLIBRE_VER = __MAPLIBRE_VER__;
import type { HeadProps } from '../prerender';

interface Props extends HeadProps {
  body?: string;       // the shell with a school prerendered into it (Task 3); default: the empty shell
  sideOpen?: boolean;  // body.side-open, as openSide() sets it
  noindex?: boolean;   // the 404 page
  notFound?: boolean;  // body[data-notfound]: boot toasts "Fant ikke …"
}
const { title, description, canonical, ogTitle, ogDescription, twitterDescription, ogImage, ogImageAlt,
        body = shellSrc, sideOpen = false, noindex = false, notFound = false } = Astro.props;
---
<!doctype html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{/* a page kept out of the index names no canonical: the 404 is not the home page */}
{!noindex && <link rel="canonical" href={canonical}>}
{noindex && <meta name="robots" content="noindex">}
<!-- Google Search Console issues one token per URL-prefix property. The first
     tag verifies https://poengkart-no.vercel.app/ (17 Sept 2026) and
     https://poengkart.vercel.app/ (22 Sept 2026); Google rejected it for
     https://poengkart.no/ ("a meta tag for a different site"), which the
     second tag verifies (26 Sept 2026). The old properties must stay
     verified for Search Console's Change of Address, so both tags stay.
     Removing either un-verifies its properties. -->
<meta name="google-site-verification" content="nstWEgPKGkzQDB8692StPPh6C1gsEGfjoOXMiDN6lJo">
<meta name="google-site-verification" content="riDcCax_USdJFe_zaK7j3XA_xw37t8B3XPz2pALleTI">

<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#2a78d6" data-c="#2a78d6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1116" data-c="#0e1116" media="(prefers-color-scheme: dark)">

<!-- link previews in messaging apps and social. The home page's og.png is
     built by tools/make_og.py from the live dataset; a school page names its
     own card, drawn at build time by web/src/pages/og/[fylke]/[skole].png.ts.
     Either way the picture is made from the data, so it never goes stale. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Poengkart">
<meta property="og:locale" content="nb_NO">
<meta property="og:locale:alternate" content="en_GB">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={twitterDescription}>
<meta name="twitter:image" content={ogImage}>

<!-- Instrument Sans (SIL Open Font License) is served from here rather than
     from Google Fonts: no visitor's IP reaches a third party for a typeface,
     and a network that blocks Google still gets the font. -->
<link rel="preload" href="/fonts/InstrumentSans-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/instrument-sans.css">
<!-- MapLibre GL 6.10.0 is served from this origin (see astro.config.mjs)
     rather than a CDN: a school or municipal network that blocks the CDN used
     to get a blank page, and a third party could otherwise change the code
     that runs on every visit. The two preloads below start the data fetches
     before the script arrives. -->
<link rel="preload" href="/data/schools.json" as="fetch" crossorigin>
<link rel="preload" href="/data/model.json" as="fetch" crossorigin>
<!-- and the engine itself: Astro preloads the chunks it bundled, but not an
     external one. The app chunk imports the first module, which imports the
     second, so without these the two are a serial chain begun only once the
     app's script has parsed. -->
<link rel="modulepreload" href={`/maplibre/${MAPLIBRE_VER}/maplibre-gl.mjs`}>
<link rel="modulepreload" href={`/maplibre/${MAPLIBRE_VER}/maplibre-gl-shared.mjs`}>
<!-- cookieless page counts; a no-op until Web Analytics is enabled on the Vercel project -->
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script is:inline>
/* saved display preferences, applied before first paint so nothing flashes */
/* and the mark that scripts run at all: without it the controls are dead
   glass, and app.css takes them out of the noscript notice's way */
document.documentElement.dataset.js = '1';
try {
  var _d = document.documentElement, _v;
  if ((_v = localStorage.getItem('pk-theme')) === 'light' || _v === 'dark') {
    _d.dataset.theme = _v;
    /* the browser's own toolbar follows the pinned theme, not the OS */
    var _ms = document.querySelectorAll('meta[name="theme-color"]');
    for (var _i = 0; _i < _ms.length; _i++) _ms[_i].content = _v === 'dark' ? '#0e1116' : '#2a78d6';
  }
  if ((_v = localStorage.getItem('pk-font')) === 'lg' || _v === 'xl') _d.dataset.font = _v;
  if (localStorage.getItem('pk-cvd') === '1') _d.dataset.cvd = '1';
} catch (e) {}
</script>
</head>
<body class:list={[sideOpen && 'side-open']} data-notfound={notFound ? '1' : undefined}>
<Fragment set:html={body} />
<script src="../main.ts"></script>
</body>
</html>
