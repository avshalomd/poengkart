---
// The <head> of every page, the prefs script that runs before first paint,
// the shell, and the one client script. The three stylesheets are imported
// here in the order the old <head> loaded them: Leaflet, its cluster plugin,
// then the app, whose rules must win the cascade.
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import '../styles/app.css';
import shellSrc from '../shell.html?raw';
import type { HeadProps } from '../prerender';

interface Props extends HeadProps {
  body?: string;       // the shell with a school prerendered into it (Task 3); default: the empty shell
  sideOpen?: boolean;  // body.side-open, as openSide() sets it
  noindex?: boolean;   // the 404 page
  notFound?: boolean;  // body[data-notfound]: boot toasts "Fant ikke …"
}
const { title, description, canonical, ogTitle, ogDescription, twitterDescription, ogImage, ogImageAlt,
        body = shellSrc, sideOpen = false, noindex = false, notFound = false } = Astro.props;
---
<!doctype html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}

<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#2a78d6" data-c="#2a78d6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1116" data-c="#0e1116" media="(prefers-color-scheme: dark)">

<!-- link previews in messaging apps and social; og.png is built by
     tools/make_og.py from the live dataset, so it never goes stale -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Poengkart">
<meta property="og:locale" content="nb_NO">
<meta property="og:locale:alternate" content="en_GB">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={twitterDescription}>
<meta name="twitter:image" content={ogImage}>

<!-- Instrument Sans (SIL Open Font License) is served from here rather than
     from Google Fonts: no visitor's IP reaches a third party for a typeface,
     and a network that blocks Google still gets the font. -->
<link rel="preload" href="/fonts/InstrumentSans-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/instrument-sans.css">
<!-- Leaflet 1.9.4 and markercluster 1.5.3 are bundled from npm (imports in
     web/src/main.ts) rather than loaded from unpkg: a school or municipal
     network that blocks the CDN used to get a blank page, and a third party
     could otherwise change the code that runs on every visit. The two
     preloads below start the data fetches before the script arrives. -->
<link rel="preload" href="/data/schools.json" as="fetch" crossorigin>
<link rel="preload" href="/data/model.json" as="fetch" crossorigin>
<!-- cookieless page counts; a no-op until Web Analytics is enabled on the Vercel project -->
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script is:inline>
/* saved display preferences, applied before first paint so nothing flashes */
try {
  var _d = document.documentElement, _v;
  if ((_v = localStorage.getItem('pk-theme')) === 'light' || _v === 'dark') {
    _d.dataset.theme = _v;
    /* the browser's own toolbar follows the pinned theme, not the OS */
    var _ms = document.querySelectorAll('meta[name="theme-color"]');
    for (var _i = 0; _i < _ms.length; _i++) _ms[_i].content = _v === 'dark' ? '#0e1116' : '#2a78d6';
  }
  if ((_v = localStorage.getItem('pk-font')) === 'lg' || _v === 'xl') _d.dataset.font = _v;
  if (localStorage.getItem('pk-cvd') === '1') _d.dataset.cvd = '1';
} catch (e) {}
</script>
</head>
<body class:list={[sideOpen && 'side-open']} data-notfound={notFound ? '1' : undefined}>
<Fragment set:html={body} />
<script src="../main.ts"></script>
</body>
</html>
